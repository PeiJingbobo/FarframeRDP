+#ifndef _WIN32
+static BOOL drive_file_path_is_below_base(const WCHAR* base_path, const WCHAR* fullpath)
+{
+	BOOL rc = FALSE;
+	char* base = nullptr;
+	char* candidate = nullptr;
+	char resolvedBase[PATH_MAX] = WINPR_C_ARRAY_INIT;
+	char resolvedPrefix[PATH_MAX] = WINPR_C_ARRAY_INIT;
+
+	if (!base_path || !fullpath)
+		goto out;
+	base = ConvertWCharToUtf8Alloc(base_path, nullptr);
+	candidate = ConvertWCharToUtf8Alloc(fullpath, nullptr);
+	if (!base || !candidate || !realpath(base, resolvedBase))
+		goto out;
+
+	for (;;)
+	{
+		if (realpath(candidate, resolvedPrefix))
+			break;
+		char* slash = strrchr(candidate, '/');
+		if (!slash || slash == candidate)
+			goto out;
+		*slash = '\0';
+	}
+
+	const size_t baseLength = strlen(resolvedBase);
+	if ((strncmp(resolvedBase, resolvedPrefix, baseLength) == 0) &&
+	    ((resolvedPrefix[baseLength] == '\0') || (resolvedPrefix[baseLength] == '/')))
+		rc = TRUE;
+out:
+	free(base);
+	free(candidate);
+	return rc;
+}
+#else
+static BOOL drive_file_path_is_below_base(const WCHAR* base_path, const WCHAR* fullpath)
+{
+	return base_path && fullpath;
+}
+#endif
